{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/handler.mjs": {"includeFiles": "{server,src}/**", "maxDuration": 30}},
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/handler?route=/api/:path*"},
    {"source": "/b/:slug", "destination": "/index.html"},
    {"source": "/admin/:path*", "destination": "/index.html"},
    {"source": "/login", "destination": "/index.html"},
    {"source": "/accept-invite", "destination": "/index.html"},
    {"source": "/forgot-password", "destination": "/index.html"},
    {"source": "/reset-password", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/b/:slug", "headers": [{"key":"Cache-Control","value":"no-store"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]},
    {"source": "/api/:path*", "headers": [{"key":"Cache-Control","value":"no-store"}]}
  ]
}
