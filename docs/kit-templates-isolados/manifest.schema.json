{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bio-Sites · Manifesto de Template Isolado v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "biosite-isolated-template"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "html": {
      "const": "template.html"
    },
    "css": {
      "const": "styles.css"
    },
    "business": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "maxLength": 300,
          "enum": [
            "loja de roupas",
            "barbearia",
            "salão / estética",
            "restaurante / lanchonete",
            "doceria / padaria",
            "oficina / serviços",
            "comercial geral"
          ]
        },
        "phone": {
          "type": "string",
          "maxLength": 300
        },
        "address": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "name",
        "category",
        "phone",
        "address"
      ],
      "additionalProperties": false
    },
    "fields": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,49}$"
      },
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "#/$defs/field"
          },
          {
            "not": {
              "required": [
                "globalField"
              ]
            }
          }
        ]
      }
    },
    "collections": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,49}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 100
          },
          "fields": {
            "type": "object",
            "maxProperties": 100,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_-]{0,49}$"
            },
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/$defs/field"
                },
                {
                  "not": {
                    "required": [
                      "bioField"
                    ]
                  }
                }
              ]
            }
          },
          "maxItems": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          }
        },
        "required": [
          "label",
          "fields",
          "maxItems"
        ],
        "additionalProperties": false
      }
    },
    "content": {
      "$ref": "#/$defs/content"
    }
  },
  "required": [
    "format",
    "version",
    "name",
    "html",
    "css",
    "business",
    "fields",
    "collections",
    "content"
  ],
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "text",
            "price",
            "image",
            "link",
            "whatsapp"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "globalField": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,49}$"
        },
        "bioField": {
          "enum": [
            "name",
            "phone",
            "address",
            "instagram"
          ]
        }
      },
      "required": [
        "type",
        "label"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "maxLength"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "message"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "whatsapp"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "globalField"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "enum": [
                  "link",
                  "whatsapp"
                ]
              }
            },
            "not": {
              "required": [
                "maxLength"
              ]
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,49}$"
        },
        "values": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,49}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 3700000
          }
        }
      },
      "required": [
        "id",
        "values"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,49}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 3700000
          }
        },
        "collections": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,49}$"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "$ref": "#/$defs/item"
            }
          }
        }
      },
      "required": [
        "fields",
        "collections"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "O validador do servidor verifica vínculos HTML, referências globais, inventário, CSS, URLs, mídia, limites e categorias. JSON Schema isoladamente não comprova segurança nem fidelidade."
}
